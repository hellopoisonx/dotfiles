#!/usr/bin/env bash
# fuzzel 电源菜单 — 关机/重启/睡眠/锁屏/注销
set -euo pipefail

choices=$(printf '%s\n' \
    '锁屏 lock' \
    '睡眠 suspend' \
    '注销 logout' \
    '重启 reboot' \
    '关机 shutdown')

# 用 --prompt 覆盖 dmenu 模式下的 prompt，与输入提示分开
selection=$(echo "$choices" | fuzzel --dmenu --prompt='电源: ')

case "$selection" in
    *锁屏*)    swaylock -f ;;
    *睡眠*)    systemctl suspend ;;
    *注销*)    niri msg action quit ;;
    *重启*)    systemctl reboot ;;
    *关机*)    systemctl poweroff ;;
    *)         exit 0 ;;
esac
