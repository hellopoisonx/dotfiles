// @aquifolly https://github.com/aquifolly/catppuccin-niri/raw/refs/heads/push-nturwpmwqsnn/themes/mocha/catppuccin-mocha-flamingo.kdl

layout {
    // Theme: Catppuccin Mocha - flamingo
    background-color "#1e1e2e"

    gaps 10

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
        active-color "#f2cdcd"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }

    border {
        on
        active-color "#f2cdcd"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }

    shadow {
        off
        color "#11111b4d"
        inactive-color "#1e1e2e4d"
    }

    tab-indicator {
        active-color "#f2cdcd"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }

    insert-hint {
        color "#fab387"
    }

    struts {
        left 6
        right 6
        top 6
        bottom 6
    }
}

recent-windows {
    highlight {
        active-color "#f2cdcd"
        urgent-color "#f38ba8"
    }
}

overview {
    zoom 0.75
    backdrop-color "#181825"
    workspace-shadow {
        off
    }
}
